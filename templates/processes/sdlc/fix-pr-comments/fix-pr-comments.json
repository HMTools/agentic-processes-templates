{
  "type": "template",
  "name": "fix-pr-comments",
  "category": "sdlc",
  "metadata": {
    "title": "Fix PR Comments",
    "purposeAndUsage": "Iterative workflow to address PR review comments. Fetches active comments from Azure DevOps, creates a fix plan, implements fixes, replies to reviewers, and pauses for the next round of feedback. Loops until the PR is clean.",
    "lastUpdated": "2026-05-21"
  },
  "parameters": {
    "required": [
      "workItemId"
    ],
    "optional": [],
    "definitions": {
      "workItemId": {
        "description": "Azure DevOps work item ID (used to find the associated PR)",
        "type": "string",
        "example": "123456"
      }
    }
  },
  "steps": [
    {
      "number": 0,
      "name": "Detect Repository",
      "stepRef": "@step:sdlc/detect-repository",
      "output": "Repository ID"
    },
    {
      "number": 1,
      "name": "Fetch PR and Comments",
      "stepRef": "@step:sdlc/fetch-pr-comments",
      "output": "PR details and active comment threads"
    },
    {
      "number": 2,
      "name": "Analyze and Plan Fixes",
      "stepRef": "@step:sdlc/analyze-plan-fixes",
      "output": "Fix plan with categorized comments",
      "approvalRequired": true
    },
    {
      "number": 3,
      "name": "Implement Fixes",
      "stepRef": "@step:sdlc/implement-fixes",
      "output": "Code changes committed and pushed"
    },
    {
      "number": 4,
      "name": "Reply to Comments",
      "stepRef": "@step:sdlc/reply-to-comments",
      "output": "Replies posted to PR comment threads"
    },
    {
      "number": 5,
      "name": "Await Reviewer Response",
      "stepRef": "@step:sdlc/await-reviewer-response",
      "output": "User decision: loop or exit",
      "approvalRequired": true,
      "loopBackTo": 1
    },
    {
      "number": 6,
      "name": "Continuous Improvement",
      "stepRef": "@step:learning/continuous-improvement",
      "output": "Improvements implemented",
      "approvalRequired": true
    },
    {
      "number": 7,
      "name": "End Process Validation",
      "stepRef": "@step:common/end-process-validation",
      "output": "Compliance report"
    }
  ],
  "references": {
    "steps": [
      "@step:sdlc/detect-repository",
      "@step:sdlc/fetch-pr-comments",
      "@step:sdlc/analyze-plan-fixes",
      "@step:sdlc/implement-fixes",
      "@step:sdlc/reply-to-comments",
      "@step:sdlc/await-reviewer-response",
      "@step:learning/continuous-improvement",
      "@step:common/end-process-validation"
    ],
    "relatedTemplates": [
      "sdlc"
    ],
    "dependencies": []
  }
}
