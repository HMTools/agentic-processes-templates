{
  "type": "template",
  "id": "2932a013-81b1-487b-8f0c-991549eedeef",
  "name": "set-concept",
  "category": "infrastructure",
  "metadata": {
    "title": "Set Concept",
    "purposeAndUsage": "Systematic workflow for implementing or updating a concept (pattern, structure, standard, or approach) across non-code files. Use when you need to implement a new pattern across documentation, update an existing concept consistently, or apply best practices to non-code files.",
    "lastUpdated": "2026-01-19"
  },
  "parameters": {
    "required": [
      "conceptName",
      "conceptDescription",
      "targetFiles"
    ],
    "optional": [
      "existingState",
      "requestedState",
      "verificationCriteria",
      "excludePatterns"
    ],
    "definitions": {
      "conceptName": {
        "description": "Name of the concept to implement",
        "type": "string",
        "example": "Layered Documentation Structure"
      },
      "conceptDescription": {
        "description": "Detailed description of what the concept entails",
        "type": "string",
        "example": "Separate user-readable content from agent instructions in markdown files"
      },
      "targetFiles": {
        "description": "Files or patterns to apply the concept to",
        "type": "string",
        "example": "All markdown files in ~/.claude/agentic-processes/"
      },
      "existingState": {
        "description": "Description of current state before implementation",
        "type": "string",
        "example": "Files mix user and agent content without separation"
      },
      "requestedState": {
        "description": "Description of desired end state after implementation",
        "type": "string",
        "example": "Clear separation between user layer and agent layer"
      },
      "verificationCriteria": {
        "description": "Criteria to verify successful implementation",
        "type": "string",
        "example": "All files have clear layer separation, JSON companions exist"
      },
      "excludePatterns": {
        "description": "File patterns to exclude from processing",
        "type": "string",
        "example": "*.test.md, drafts/**"
      }
    }
  },
  "steps": [
    {
      "number": 1,
      "name": "Understand concept",
      "stepRef": "28047be4-e7c5-4152-8329-2929982ad042",
      "approvalRequired": true,
      "stepRefName": "understand-context",
      "viewRef": "554f3677-1f03-427f-b8d0-3506c98d09e6"
    },
    {
      "number": 2,
      "name": "Identify target files",
      "stepRef": "bbf0decb-59c7-4623-9d99-34788789b4f0",
      "stepRefName": "identify-files"
    },
    {
      "number": 3,
      "name": "Analyze existing state",
      "stepRef": "8aecb57e-d096-4cac-81f3-a1e4c5f7a2e1",
      "stepRefName": "review-verify-document"
    },
    {
      "number": 4,
      "name": "Design implementation plan",
      "stepRef": "5fd46afb-b722-4ee9-9311-86f5d9c86365",
      "approvalRequired": true,
      "stepRefName": "design-implementation-plan",
      "viewRef": "f63d38c9-ef42-4b5c-9763-8f873fc09831"
    },
    {
      "number": 5,
      "name": "Apply changes",
      "stepRef": "6c53947a-ba9c-469a-930a-7af1238d1d91",
      "stepRefName": "apply-changes"
    },
    {
      "number": 6,
      "name": "Verify implementation",
      "stepRef": "8aecb57e-d096-4cac-81f3-a1e4c5f7a2e1",
      "stepRefName": "review-verify-document"
    }
  ],
