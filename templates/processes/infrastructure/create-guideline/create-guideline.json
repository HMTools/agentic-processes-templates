{
  "type": "template",
  "id": "9a8832a9-da6a-4e91-acfd-63dd1560475e",
  "name": "create-guideline",
  "category": "infrastructure",
  "metadata": {
    "title": "Create Guideline",
    "purposeAndUsage": "Create guideline documents that answer 'How to do X?' questions with practical, action-oriented content. Use when a process step references a missing guideline, or when establishing new best practices for the framework.",
    "lastUpdated": "2026-01-24"
  },
  "parameters": {
    "required": [
      "guidelineName",
      "guidelineCategory",
      "guidelinePurpose"
    ],
    "optional": [
      "relatedSteps",
      "triggeringContext"
    ],
    "definitions": {
      "guidelineName": {
        "description": "Name of the action (kebab-case, without 'how-to-' prefix)",
        "type": "string",
        "example": "implement-controllers"
      },
      "guidelineCategory": {
        "description": "Category folder for the guideline. Use existing category if it fits, or create new if needed.",
        "type": "string",
        "example": "api-design",
        "existingCategories": [
          "api-design",
          "data-access",
          "docs",
          "implementation",
          "planning",
          "testing"
        ]
      },
      "guidelinePurpose": {
        "description": "The 'How to' question this guideline answers",
        "type": "string",
        "example": "How to implement API controllers following project conventions"
      },
      "relatedSteps": {
        "description": "Steps that will reference this guideline",
        "type": "array",
        "example": [
          "api/implement-controller-layer"
        ]
      },
      "triggeringContext": {
        "description": "What triggered the need for this guideline",
        "type": "string",
        "example": "Step api/implement-controller-layer referenced missing guideline"
      }
    }
  },
  "steps": [
    {
      "number": 1,
      "name": "Understand context",
      "stepRef": "5807389c-3ea6-49c9-bcb9-6fca3730242c",
      "approvalRequired": false,
      "stepRefName": "understand-context"
    },
    {
      "number": 2,
      "name": "Create guideline file",
      "stepRef": "f0a841f7-bdb0-4f2c-b016-ca4017992149",
      "approvalRequired": true,
      "stepRefName": "create-guideline-file"
    },
    {
      "number": 3,
      "name": "Link guideline to steps",
      "stepRef": "b422e6db-5302-4cc0-9154-3587792ee00e",
      "optional": true,
      "stepRefName": "link-guideline-to-steps"
    }
  ],
  "references": {
    "steps": [
      "5807389c-3ea6-49c9-bcb9-6fca3730242c",
      "f0a841f7-bdb0-4f2c-b016-ca4017992149",
      "b422e6db-5302-4cc0-9154-3587792ee00e"
    ],
    "relatedTemplates": [],
    "dependencies": []
  },
  "guidelineFormat": {
    "filename": "how-to-{guidelineName}.md",
    "location": "~/.claude/agentic-processes/guidelines/{guidelineCategory}/",
    "structure": {
      "title": "# How to {Action}",
      "content": "Practical steps and examples to answer the 'How to' question",
      "sections": [
        "numbered steps",
        "examples",
        "code snippets (if applicable)",
        "tips/notes (optional)"
      ]
    }
  }
}
